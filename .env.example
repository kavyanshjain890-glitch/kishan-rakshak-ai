# Environment Variables Example for KISHAN RAKSHAK AI
# NEVER commit production secrets or service role keys to Git.

# Database / Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# IMD API Credentials (Phase 0/3)
IMD_API_KEY=
IMD_JWT_TOKEN=

# App Configuration
NEXT_PUBLIC_APP_ENV=development
ADMIN_SECRET_KEY=admin-secret-dev-key
NEXT_PUBLIC_CONFIDENCE_THRESHOLD=0.70
